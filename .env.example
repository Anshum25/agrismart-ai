# Copy this file to .env (never commit .env).

# Groq API key: powers AI advice, translation and the voice assistant.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Comma-separated list of frontend origins allowed to call the API (CORS).
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# URL of the ONNX model the backend downloads on startup if it is missing
# (e.g. a GitHub Release asset). Optional SHA256 to verify the download.
MODEL_URL=
MODEL_SHA256=

# SQLite database for outbreak reports + advice cache.
DB_PATH=backend/data/agrismart.db

# Seed clearly-labelled simulated outbreak reports when the DB is empty (1/0).
SEED_DEMO_DATA=1

# Fallback location for weather when the user does not share location (New Delhi).
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
